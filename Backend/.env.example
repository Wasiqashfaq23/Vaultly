# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/vaultly

# Secret used to sign JWT session tokens
# Generate one with: openssl rand -hex 32
JWT_SECRET=change_me

# Used to encrypt vault entries at rest (AES-256-GCM)
# Must be 32 bytes / 64 hex characters. Generate one with: openssl rand -hex 32
VAULT_MASTER_KEY=change_me

# development | production
NODE_ENV=development

# Backend port
PORT=8001

# Comma-separated allowed frontend origins (CORS)
# e.g. https://vaultly.vercel.app,http://localhost:5173,http://localhost:5174
CORS_ORIGINS=https://vaultly.vercel.app,http://localhost:5173,http://localhost:5174

# SMTP for email verification (Gmail example — use an App Password, never your Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Vaultly <noreply@example.com>

# Base URL of the deployed frontend (used to build verification links)
FRONTEND_URL=http://localhost:5173